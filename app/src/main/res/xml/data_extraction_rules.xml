<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The prayer tracker and Qada record are left out of cloud backup.
     Downloaded hadith books are left out too, since they can be downloaded again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="salah_tracker.db" />
        <exclude domain="database" path="salah_tracker.db-shm" />
        <exclude domain="database" path="salah_tracker.db-wal" />
        <exclude domain="database" path="salah_tracker.db-journal" />
        <exclude domain="sharedpref" path="prayer_silence.xml" />
        <!-- Goals and reading time, like the tracker, stay on this phone. -->
        <exclude domain="file" path="datastore/goals.preferences_pb" />
        <exclude domain="database" path="hadith.db" />
        <exclude domain="database" path="hadith.db-shm" />
        <exclude domain="database" path="hadith.db-wal" />
        <exclude domain="database" path="hadith.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="salah_tracker.db" />
        <exclude domain="database" path="salah_tracker.db-shm" />
        <exclude domain="database" path="salah_tracker.db-wal" />
        <exclude domain="database" path="salah_tracker.db-journal" />
        <exclude domain="sharedpref" path="prayer_silence.xml" />
        <!-- Goals and reading time, like the tracker, stay on this phone. -->
        <exclude domain="file" path="datastore/goals.preferences_pb" />
        <exclude domain="database" path="hadith.db" />
        <exclude domain="database" path="hadith.db-shm" />
        <exclude domain="database" path="hadith.db-wal" />
        <exclude domain="database" path="hadith.db-journal" />
    </device-transfer>
</data-extraction-rules>
